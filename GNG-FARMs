function GNGNpcPivot(name)
local function ok(cf)
return cf and cf.Position.Magnitude > 50
end
local good, npc = pcall(DetectNpc, name)
if good and npc then
local g2, cf = pcall(function() return npc:GetPivot() end)
if g2 and ok(cf) then return cf end
end
for _, folder in ipairs({ workspace:FindFirstChild("NPCs"), game:GetService("ReplicatedStorage"):FindFirstChild("NPCs") }) do
local m = folder and folder:FindFirstChild(name)
if m then
local g3, cf = pcall(function() return m:GetPivot() end)
if g3 and ok(cf) then return cf end
end
end
local g4, list = pcall(function() return NPCManager.getNPCsByName(name) end)
if g4 and list and list[1] then
local n = list[1]
local g5, cf = pcall(function() return n._modelState._instance:GetPivot() end)
if g5 and ok(cf) then return cf end
for _, key in ipairs({ "cframe", "CFrame", "_cframe", "spawnCFrame", "position", "Position", "_position" }) do
local v = n[key]
if typeof(v) == "Vector3" then v = CFrame.new(v) end
if typeof(v) == "CFrame" and ok(v) then return v end
end
end
return nil
end
