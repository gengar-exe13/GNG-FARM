local function score(name, q)
local n = name:lower()
if n:sub(1, #q) == q then return 0 end
if n:find("[%s%p]" .. q:gsub("%p", "%%%0")) then return 1 end
if n:find(q, 1, true) then return 2 end
local i = 1
